extends SceneTree

func _init() -> void:
	call_deferred("_run_test")

func _run_test() -> void:
	print("--- TEST UI LOCALIZATION INTEGRATION & REACTION ---")
	
	var PlantDatabaseScript = load("res://scripts/plants/plant_database.gd")
	var sp_wheat: Dictionary = PlantDatabaseScript.get_species("wheat")
	var sp_rose: Dictionary = PlantDatabaseScript.get_species("flower_rose")
	
	# 1. Testar em Português
	TranslationServer.set_locale("pt_BR")
	assert(PlantDatabaseScript.get_species_name(sp_wheat) == "Trigo Dourado Enraizado", "Falha wheat pt_BR")
	assert(PlantDatabaseScript.get_species_name(sp_rose) == "Rosa Rubra Nobre", "Falha rose pt_BR")
	assert(tr("NAV_HOME") == "Início", "Falha NAV_HOME pt_BR")
	assert(tr("NAV_HERBARIUM") == "Herbário", "Falha NAV_HERBARIUM pt_BR")
	assert(tr("NAV_STORE") == "Loja", "Falha NAV_STORE pt_BR")
	assert(tr("NAV_WORKSHOP") == "Oficina", "Falha NAV_WORKSHOP pt_BR")
	assert(tr("CARD_STARS") == "Estrelas", "Falha CARD_STARS pt_BR")
	assert(tr("HUD_LEVEL_CLEAR") % 3 == "FASE 03 CONCLUÍDA!", "Falha HUD_LEVEL_CLEAR pt_BR")
	assert(tr("GARAGE_TITLE_HEADER") == "Oficina do Bot", "Falha GARAGE_TITLE_HEADER pt_BR")
	assert(tr("STORE_TITLE") == "Loja do Arquipélago", "Falha STORE_TITLE pt_BR")
	assert(tr("HERBARIUM_FULL_TITLE") == "Herbário da Ilha & Itens", "Falha HERBARIUM_FULL_TITLE pt_BR")
	assert(tr("BIOME_TROPICAL_ISLAND") == "Ilha Tropical", "Falha BIOME_TROPICAL_ISLAND pt_BR")
	assert(tr("BLADE_LEVEL_MAX") == "NÍVEL MÁXIMO", "Falha BLADE_LEVEL_MAX pt_BR")
	assert(tr("WORKSHOP_TITLE") == "Oficina de Upgrades", "Falha WORKSHOP_TITLE pt_BR")
	assert(tr("TOAST_QUALITY_PERFORMANCE") == "Qualidade 3D: Econômica (70% FSR - Bateria)", "Falha TOAST_QUALITY_PERFORMANCE pt_BR")
	print("✔ Testes integrados de UI em pt_BR aprovados.")
	
	# 2. Testar em Inglês
	TranslationServer.set_locale("en")
	assert(PlantDatabaseScript.get_species_name(sp_wheat) == "Golden Rooted Wheat", "Falha wheat en")
	assert(PlantDatabaseScript.get_species_name(sp_rose) == "Noble Red Rose", "Falha rose en")
	assert(tr("NAV_HOME") == "Home", "Falha NAV_HOME en")
	assert(tr("NAV_HERBARIUM") == "Herbarium", "Falha NAV_HERBARIUM en")
	assert(tr("NAV_STORE") == "Store", "Falha NAV_STORE en")
	assert(tr("NAV_WORKSHOP") == "Workshop", "Falha NAV_WORKSHOP en")
	assert(tr("CARD_STARS") == "Stars", "Falha CARD_STARS en")
	assert(tr("HUD_LEVEL_CLEAR") % 3 == "LEVEL 03 CLEARED!", "Falha HUD_LEVEL_CLEAR en")
	assert(tr("GARAGE_TITLE_HEADER") == "Bot Workshop", "Falha GARAGE_TITLE_HEADER en")
	assert(tr("STORE_TITLE") == "Archipelago Shop", "Falha STORE_TITLE en")
	assert(tr("HERBARIUM_FULL_TITLE") == "Island Herbarium & Items", "Falha HERBARIUM_FULL_TITLE en")
	assert(tr("BIOME_TROPICAL_ISLAND") == "Tropical Island", "Falha BIOME_TROPICAL_ISLAND en")
	assert(tr("BLADE_LEVEL_MAX") == "MAX LEVEL", "Falha BLADE_LEVEL_MAX en")
	assert(tr("WORKSHOP_TITLE") == "Upgrade Workshop", "Falha WORKSHOP_TITLE en")
	assert(tr("TOAST_QUALITY_PERFORMANCE") == "3D Quality: Performance (70% FSR - Battery)", "Falha TOAST_QUALITY_PERFORMANCE en")
	print("✔ Testes integrados de UI em en aprovados.")
	
	# 3. Testar em Espanhol
	TranslationServer.set_locale("es")
	assert(PlantDatabaseScript.get_species_name(sp_wheat) == "Trigo Dorado Enraizado", "Falha wheat es")
	assert(PlantDatabaseScript.get_species_name(sp_rose) == "Rosa Roja Noble", "Falha rose es")
	assert(tr("NAV_HOME") == "Inicio", "Falha NAV_HOME es")
	assert(tr("NAV_HERBARIUM") == "Herbario", "Falha NAV_HERBARIUM es")
	assert(tr("NAV_STORE") == "Tienda", "Falha NAV_STORE es")
	assert(tr("NAV_WORKSHOP") == "Taller", "Falha NAV_WORKSHOP es")
	assert(tr("CARD_STARS") == "Estrellas", "Falha CARD_STARS es")
	assert(tr("HUD_LEVEL_CLEAR") % 3 == "¡NIVEL 03 COMPLETADO!", "Falha HUD_LEVEL_CLEAR es")
	assert(tr("GARAGE_TITLE_HEADER") == "Taller del Bot", "Falha GARAGE_TITLE_HEADER es")
	assert(tr("STORE_TITLE") == "Tienda del Archipiélago", "Falha STORE_TITLE es")
	assert(tr("HERBARIUM_FULL_TITLE") == "Herbario de la Isla & Ítems", "Falha HERBARIUM_FULL_TITLE es")
	assert(tr("BIOME_TROPICAL_ISLAND") == "Isla Tropical", "Falha BIOME_TROPICAL_ISLAND es")
	assert(tr("BLADE_LEVEL_MAX") == "NIVEL MÁXIMO", "Falha BLADE_LEVEL_MAX es")
	assert(tr("WORKSHOP_TITLE") == "Taller de Mejoras", "Falha WORKSHOP_TITLE es")
	assert(tr("TOAST_QUALITY_PERFORMANCE") == "Calidad 3D: Rendimiento (70% FSR - Batería)", "Falha TOAST_QUALITY_PERFORMANCE es")
	print("✔ Testes integrados de UI em es aprovados.")

	# 4. Testar Instanciação de Cenas e Notificação de Tradução
	var garage_scene = load("res://scenes/menu/tabs/tab_garage.tscn").instantiate()
	root.add_child(garage_scene)
	TranslationServer.set_locale("en")
	garage_scene.notification(Node.NOTIFICATION_TRANSLATION_CHANGED)
	assert(garage_scene.title_label.text == "Bot Workshop", "Falha na reação de idioma em TabGarage")
	
	var store_scene = load("res://scenes/menu/tabs/tab_store.tscn").instantiate()
	root.add_child(store_scene)
	TranslationServer.set_locale("es")
	store_scene.notification(Node.NOTIFICATION_TRANSLATION_CHANGED)
	assert(store_scene.title_label.text == "Tienda del Archipiélago", "Falha na reação de idioma em TabStore")
	
	var clouds_scene = load("res://scenes/menu/clouds_end_node.tscn").instantiate()
	root.add_child(clouds_scene)
	TranslationServer.set_locale("en")
	clouds_scene.notification(Node.NOTIFICATION_TRANSLATION_CHANGED)
	assert(clouds_scene.title_label.text == "MORE LEVELS COMING SOON", "Falha na reação de idioma em CloudsEndNode")

	var pause_modal_scene = load("res://scenes/ui/pause_modal.tscn").instantiate()
	root.add_child(pause_modal_scene)
	TranslationServer.set_locale("es")
	pause_modal_scene.notification(Node.NOTIFICATION_TRANSLATION_CHANGED)
	assert(pause_modal_scene._title_lbl.text == "PAUSA", "Falha PauseModal es")
	TranslationServer.set_locale("en")
	pause_modal_scene.notification(Node.NOTIFICATION_TRANSLATION_CHANGED)
	assert(pause_modal_scene._title_lbl.text == "PAUSE", "Falha PauseModal en")

	var defeat_modal_scene = load("res://scenes/ui/defeat_modal.tscn").instantiate()
	root.add_child(defeat_modal_scene)
	TranslationServer.set_locale("es")
	defeat_modal_scene.notification(Node.NOTIFICATION_TRANSLATION_CHANGED)
	assert(defeat_modal_scene._title_lbl.text == "¡TIEMPO AGOTADO!", "Falha DefeatModal es")

	var exit_modal_scene = load("res://scenes/ui/exit_modal.tscn").instantiate()
	root.add_child(exit_modal_scene)
	TranslationServer.set_locale("es")
	exit_modal_scene.notification(Node.NOTIFICATION_TRANSLATION_CHANGED)
	assert(exit_modal_scene._title_lbl.text == "¿SALIR DEL JUEGO?", "Falha ExitModal es")

	garage_scene.queue_free()
	store_scene.queue_free()
	clouds_scene.queue_free()
	pause_modal_scene.queue_free()
	defeat_modal_scene.queue_free()
	exit_modal_scene.queue_free()

	print("✔ Testes de instanciação e reatividade NOTIFICATION_TRANSLATION_CHANGED aprovados!")
	print("--- TODOS OS TESTES INTEGRADOS DE LOCALIZAÇÃO PASSARAM COM 100% DE SUCESSO! ---")
	quit(0)
